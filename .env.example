# OsuZenith Frontend
# Copie este arquivo para .env no ambiente local.

# URL do backend/API do servidor.
# Exemplo: https://api.osuzenith.com
BACKEND_URL=https://SEU-BACKEND-AQUI.com

# Tempo máximo de espera nas chamadas ao backend, em segundos.
BACKEND_TIMEOUT=15

# Use um valor forte em produção.
SECRET_KEY=troque-essa-chave-em-producao

# Links exibidos na home.
CLIENT_DOWNLOAD_URL=https://SEU-LINK-DE-DOWNLOAD-AQUI.com/client.apk
DISCORD_URL=https://discord.gg/SEU-CONVITE
GITHUB_URL=https://github.com/SEU-USUARIO/SEU-REPOSITORIO

# Versão exibida somente no bloco de Welcome da home.
CLIENT_VERSION=0
