{% extends "base.html" %}
{% block title %}Settings | OsuZenith{% endblock %}
{% block content %}
<style>
  .settings-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .settings-card {
    padding: 24px;
  }

  .settings-card > * {
    position: relative;
    z-index: 1;
  }

  .settings-card h2 {
    margin: 0 0 16px;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .settings-card form {
    display: grid;
    gap: 12px;
  }

  .settings-card input[type="submit"] {
    width: 100%;
    margin-top: 4px;
  }

  @media (max-width: 780px) {
    .settings-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
<section class="settings-grid">
    {% include "account/set_avatar.jinja" %}
    {% include "account/change_password.jinja" %}
    {% include "account/change_username.jinja" %}
    {% include "account/change_email.jinja" %}
</section>
{% endblock content %}
