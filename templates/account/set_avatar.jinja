<section class="surface-card settings-card">
  <h2>Set Avatar</h2>
  <form method="post" enctype="multipart/form-data" action="/user/account/set-avatar">
    <label for="avatar">Avatar image</label>
    <input id="avatar" type="file" name="avatar" accept="image/*" required>
    <input type="submit" value="Upload">
  </form>
</section>
