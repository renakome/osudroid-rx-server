{% extends "base.html" %}
{% block title %}Password Recovery | OsuZenith{% endblock %}
{% block content %}
<style>
  .recovery-panel {
    max-width: 460px;
    margin: 40px auto;
    padding: 28px;
  }

  .recovery-panel > * {
    position: relative;
    z-index: 1;
  }

  .recovery-panel h1 {
    margin: 0 0 22px;
    text-align: center;
    font-size: 1.9rem;
    letter-spacing: -0.04em;
  }

  .recovery-panel form {
    display: grid;
    gap: 13px;
  }
</style>
<section class="recovery-panel">
    <h1>Password Recovery</h1>
    <form method="post" action="/user/password_recovery?type=submit">
        <label for="username">Username</label>
        <input class="username-select" type="text" id="username" name="username" required>
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</section>
{% endblock %}
