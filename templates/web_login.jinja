{% extends "base.html" %}

{% block title %}Login | OsuZenith{% endblock %}

{% block content %}
<style>
  .login-container {
    max-width: 430px;
    width: min(92vw, 430px);
    padding: 30px 26px;
    margin: 40px auto;
  }

  .login-container > * {
    position: relative;
    z-index: 1;
  }

  .login-container h1 {
    text-align: center;
    margin: 0 0 24px;
    font-size: 2rem;
    letter-spacing: -0.045em;
  }

  .login-container form {
    display: grid;
    gap: 12px;
  }

  .login-container input[type="submit"] {
    width: 100%;
    margin-top: 8px;
  }

  .form-note {
    text-align: center;
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: -6px;
  }

  .error {
    padding: 12px 14px;
    border-radius: 16px;
    background: rgba(255, 142, 159, 0.08);
    border: 1px solid rgba(255, 142, 159, 0.22);
    text-align: center;
    margin-bottom: 14px;
  }

  .forgot-password {
    text-align: center;
    margin-top: 18px;
  }

  .forgot-password a {
    color: #dbe8ff;
    text-decoration: none;
    font-weight: 700;
  }

  .forgot-password a:hover {
    text-decoration: underline;
  }
</style>

<div class="login-container" role="main" aria-labelledby="login-title">
  <h1 id="login-title">Login</h1>

  {% if error_message %}
    <div class="error" role="alert">
      <p>{{ error_message }}</p>
    </div>
  {% endif %}

  <form method="post" novalidate>
    <label for="username">Username</label>
    <input
      type="text"
      id="username"
      name="username"
      class="username-select"
      placeholder="Enter username"
      required
      autocomplete="username"
      minlength="3"
      maxlength="20"
      pattern="^[a-zA-Z0-9_]+$"
      aria-describedby="username-note"
    />
    <div id="username-note" class="form-note">3-20 characters, letters, numbers, and underscores only</div>

    <label for="password">Password</label>
    <input
      type="password"
      id="password"
      name="password"
      placeholder="Enter password"
      required
      minlength="6"
      autocomplete="current-password"
      aria-describedby="password-note"
    />
    <div id="password-note" class="form-note">At least 6 characters</div>

    <input type="submit" value="Login" />
  </form>

  <div class="forgot-password">
    <a href="/user/password_recovery">Forgot password?</a>
  </div>
</div>
{% endblock %}
