{% extends "base.html" %}

{% block title %}OsuZenith{% endblock %}

{% block content %}
<style>
  .landing {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .ambient-orb {
    position: absolute;
    border-radius: 999px;
    filter: blur(18px);
    opacity: 0.58;
    animation: drift 14s ease-in-out infinite;
  }

  .ambient-orb.orb-a {
    top: 3%;
    left: -8%;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(122, 168, 255, 0.32), transparent 72%);
  }

  .ambient-orb.orb-b {
    top: 22%;
    right: -10%;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.13), transparent 70%);
    animation-delay: -4s;
  }

  .ambient-orb.orb-c {
    bottom: -8%;
    left: 20%;
    width: 360px;
    height: 360px;
    background: radial-gradient(circle, rgba(59, 99, 170, 0.34), transparent 72%);
    animation-delay: -7s;
  }

  .light-trail {
    position: relative;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.38), transparent);
    opacity: 0.5;
    transform-origin: center;
    animation: sweep 9s ease-in-out infinite;
  }

  .light-trail.trail-a {
    top: 18%;
    left: -10%;
    width: 42%;
  }

  .light-trail.trail-b {
    top: 72%;
    left: 54%;
    width: 28%;
    animation-delay: -4s;
  }

  .hero {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: 28px;
    align-items: stretch;
  }

  .hero-panel {
    padding: clamp(24px, 4vw, 40px);
    min-height: 560px;
    display: flex;
    align-items: center;
  }

  .hero-panel::after {
    content: "";
    position: absolute;
    inset: auto -18% -34% 30%;
    height: 44%;
    background: radial-gradient(ellipse, rgba(123, 170, 255, 0.20), transparent 68%);
    animation: pulseLift 7s ease-in-out infinite;
    pointer-events: none;
  }

  .hero-copy,
  .hero-aside {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--muted);
    text-transform: uppercase;
    font-size: 0.74rem;
    letter-spacing: 0.2em;
  }

  .eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(180deg, #c7deff, #76a9ff);
    box-shadow: 0 0 0 6px rgba(120, 169, 255, 0.12);
    animation: dotPulse 2.8s ease-in-out infinite;
  }

  .hero-title {
    margin: 22px 0 16px;
    max-width: 12ch;
    font-size: clamp(3rem, 7vw, 6.4rem);
    line-height: 0.92;
    letter-spacing: -0.07em;
  }

  .hero-title .ghost {
    display: block;
    color: rgba(244, 247, 251, 0.52);
    font-weight: 600;
  }

  .hero-description {
    max-width: 60ch;
    margin: 0;
    color: #c2ccda;
    font-size: 1.04rem;
    line-height: 1.86;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 26px;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: 156px;
    min-height: 52px;
    padding: 14px 20px;
    border-radius: 18px;
    text-decoration: none;
    color: var(--text);
    background:
      linear-gradient(180deg, rgba(149, 186, 255, 0.3), rgba(78, 112, 186, 0.28)),
      linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.04));
    border: 1px solid rgba(144, 179, 255, 0.24);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 18px 38px rgba(33, 60, 111, 0.24);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease,
      filter 180ms ease;
  }

  .hero-button:hover {
    transform: translateY(-2px);
    filter: brightness(1.04);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.24),
      0 22px 42px rgba(33, 60, 111, 0.34);
  }

  .hero-button.secondary {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.03)),
      linear-gradient(180deg, rgba(110, 118, 142, 0.16), rgba(110, 118, 142, 0.08));
  }

  .hero-button.is-disabled {
    pointer-events: none;
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 28px;
  }

  .stat-card {
    padding: 16px 18px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .stat-card:hover,
  .mini-tile:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.062);
    border-color: rgba(123, 170, 255, 0.18);
  }

  .stat-label {
    color: var(--muted);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .stat-value {
    margin-top: 8px;
    font-size: clamp(1.2rem, 2vw, 1.7rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .hero-aside {
    display: grid;
    gap: 18px;
  }

  .showcase-card {
    padding: 26px;
  }

  .showcase-card h2,
  .showcase-card h3,
  .showcase-card p,
  .version-chip,
  .mini-stack,
  .changelog-head,
  .changelog-body {
    position: relative;
    z-index: 1;
  }

  .showcase-card h2 {
    margin: 0 0 12px;
    font-size: 1.35rem;
  }

  .showcase-card p {
    margin: 0;
    color: #b8c2d0;
    line-height: 1.75;
  }

  .version-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding: 10px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #dbe8ff;
  }

  .version-chip strong {
    font-size: 1.08rem;
    letter-spacing: -0.04em;
  }

  .mini-stack {
    display: grid;
    gap: 14px;
    margin-top: 18px;
  }

  .mini-tile {
    position: relative;
    padding: 18px 18px 18px 58px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .mini-tile i {
    position: absolute;
    left: 18px;
    top: 18px;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: rgba(120, 169, 255, 0.14);
    color: #cfe0ff;
  }

  .mini-tile strong {
    display: block;
    margin-bottom: 5px;
  }

  .mini-tile span {
    color: #aab6c6;
    line-height: 1.6;
  }

  .changelog-card {
    padding: 0;
  }

  .changelog-head {
    padding: 22px 24px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .changelog-head h3 {
    margin: 0 0 6px;
    font-size: 1.12rem;
  }

  .changelog-head p {
    margin: 0;
    color: var(--muted);
  }

  .changelog-body {
    padding: 18px 24px 24px;
    color: #d8e1ee;
    line-height: 1.8;
    min-height: 120px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent),
      rgba(255, 255, 255, 0.02);
  }

  @keyframes drift {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(0, 22px, 0) scale(1.06); }
  }

  @keyframes sweep {
    0%, 100% { transform: translateX(0) scaleX(0.92); opacity: 0.24; }
    50% { transform: translateX(18px) scaleX(1.04); opacity: 0.72; }
  }

  @keyframes dotPulse {
    0%, 100% { box-shadow: 0 0 0 6px rgba(120, 169, 255, 0.12); }
    50% { box-shadow: 0 0 0 10px rgba(120, 169, 255, 0.05); }
  }

  @keyframes pulseLift {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); opacity: 0.7; }
    50% { transform: translate3d(-4%, -8%, 0) scale(1.05); opacity: 1; }
  }

  @media (max-width: 1100px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-panel {
      min-height: auto;
    }

    .hero-title {
      max-width: none;
    }

    .stat-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .hero-panel,
    .showcase-card {
      padding: 22px;
    }

    .hero-actions {
      flex-direction: column;
    }

    .hero-button {
      width: 100%;
    }

    .stat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="landing" aria-hidden="true">
  <div class="ambient-orb orb-a"></div>
  <div class="ambient-orb orb-b"></div>
  <div class="ambient-orb orb-c"></div>
  <div class="light-trail trail-a"></div>
  <div class="light-trail trail-b"></div>
</div>

<section class="hero">
  <article class="surface-card hero-panel">
    <div class="hero-copy">
      <div class="eyebrow">
        <span class="eyebrow-dot"></span>
        OsuZenith Relax Server
      </div>

      <h1 class="hero-title">
        OsuZenith
        <span class="ghost">Relax Server</span>
      </h1>

      <p class="hero-description">
        {{ description or "A relax server for clean plays, player profiles, leaderboards, and fast access to the latest build." }}
      </p>

      <div class="hero-actions">
        {% if download_link %}
          <a href="{{ download_link }}" class="hero-button">
            <i class="fas fa-download"></i>
            Download
          </a>
        {% else %}
          <span class="hero-button is-disabled" aria-disabled="true">
            <i class="fas fa-download"></i>
            Download
          </span>
        {% endif %}

        {% if github_url %}
          <a href="{{ github_url }}" target="_blank" rel="noopener" class="hero-button secondary">
            <i class="fab fa-github"></i>
            GitHub
          </a>
        {% else %}
          <span class="hero-button secondary is-disabled" aria-disabled="true">
            <i class="fab fa-github"></i>
            GitHub
          </span>
        {% endif %}

        {% if discord_url %}
          <a href="{{ discord_url }}" target="_blank" rel="noopener" class="hero-button secondary">
            <i class="fab fa-discord"></i>
            Discord
          </a>
        {% else %}
          <span class="hero-button secondary is-disabled" aria-disabled="true">
            <i class="fab fa-discord"></i>
            Discord
          </span>
        {% endif %}
      </div>

      <div class="stat-grid">
        <div class="stat-card">
          <div class="stat-label">Players</div>
          <div class="stat-value">{{ players }}</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Online</div>
          <div class="stat-value">{{ online }}</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Mode</div>
          <div class="stat-value">Relax</div>
        </div>
      </div>
    </div>
  </article>

  <aside class="hero-aside">
    <section class="surface-card showcase-card">
      <h2>Welcome to OsuZenith</h2>
      <p>
        Track your progress, climb the leaderboard, and jump back into relax gameplay from one clean server hub.
      </p>
      <div class="version-chip">
        <i class="fas fa-microchip"></i>
        <span>Current build</span>
        <strong>V: {{ version }}</strong>
      </div>
      <div class="mini-stack">
        <div class="mini-tile">
          <i class="fas fa-trophy"></i>
          <strong>Leaderboards</strong>
          <span>Compare top players by PP or ranked score and find profiles fast.</span>
        </div>
        <div class="mini-tile">
          <i class="fas fa-user-circle"></i>
          <strong>Player profiles</strong>
          <span>Open recent plays, top scores, stats, and avatars without extra clutter.</span>
        </div>
      </div>
    </section>

    <section class="surface-card changelog-card">
      <div class="changelog-head">
        <h3>Server news</h3>
        <p>Latest visible notes for players</p>
      </div>
      <div class="changelog-body">
        {{ changelog or "No server updates published yet." }}
      </div>
    </section>
  </aside>
</section>
{% endblock %}
