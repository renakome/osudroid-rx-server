{% extends "base.html" %}

{% block title %}Player Profile | OsuZenith{% endblock %}

{% block content %}
<style>
  .profile-card {
    max-width: 880px;
    margin: 16px auto 28px;
  }

  .profile-card > *,
  .scores-wrapper > * {
    position: relative;
    z-index: 1;
  }

  .profile-header {
    padding: 26px;
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .profile-photo {
    width: 112px;
    height: 112px;
    border-radius: 28px;
    object-fit: cover;
    border: 1px solid rgba(123, 170, 255, 0.42);
    box-shadow: 0 16px 38px rgba(44, 82, 160, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .header-info {
    flex-grow: 1;
  }

  .username {
    font-size: clamp(2rem, 4vw, 3.3rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.055em;
    margin: 0 0 10px;
  }

  .country-rank {
    margin: 0;
    color: var(--muted);
  }

  .country-flag {
    width: 30px;
    height: 20px;
    vertical-align: middle;
    border-radius: 4px;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.24);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
    padding: 0 26px 26px;
  }

  .stat {
    text-align: center;
    padding: 14px 12px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stat .label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-bottom: 6px;
  }

  .stat .value {
    font-size: 1rem;
    font-weight: 800;
    color: #dbe8ff;
  }

  .section-title {
    margin: 34px auto 12px;
    max-width: 880px;
    font-size: 1.18rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .scores-wrapper {
    max-width: 880px;
    margin: 0 auto 32px;
    padding: 18px;
    overflow-x: auto;
  }

  .scores-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
    border-radius: 18px;
  }

  .scores-table th,
  .scores-table td {
    padding: 12px 10px;
    text-align: center;
    white-space: nowrap;
  }

  .scores-table th {
    background: rgba(123, 170, 255, 0.13);
    color: #dbe8ff;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .scores-table td {
    font-size: 0.88rem;
    color: #d6deea;
  }

  .scores-table tbody tr:hover {
    background: rgba(255, 255, 255, 0.045);
  }

  .scores-table td a {
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
  }

  .scores-table td a:hover {
    color: #dbe8ff;
  }

  @media (max-width: 760px) {
    .profile-header {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 460px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="profile-card">
  <div class="profile-header">
    <img src="{{ avatar_url }}" alt="Avatar" class="profile-photo">
    <div class="header-info">
      <p class="username username-select">{{ player.username }}</p>
      <p class="country-rank">
        <img class="country-flag"
             src="https://flagsapi.com/{{ player.country }}/flat/64.png"
             alt="Flag of {{ player.country }}">
      </p>
    </div>
  </div>
  <div class="stats-grid">
    <div class="stat"><div class="label">Global Rank</div><div class="value">#{{ player_stats.pp_rank }} / #{{ player_stats.score_rank }}</div></div>
    <div class="stat"><div class="label">Country Rank</div><div class="value">#{{ player_stats.country_pp_rank }} / #{{ player_stats.country_score_rank }}</div></div>
    <div class="stat"><div class="label">PP</div><div class="value">{{ player_stats.pp }}</div></div>
    <div class="stat"><div class="label">Accuracy</div><div class="value">{{ player_stats.acc }}</div></div>
    <div class="stat"><div class="label">Playcount</div><div class="value">{{ player_stats.plays }}</div></div>
    <div class="stat"><div class="label">Level</div><div class="value">{{ level }}</div></div>
  </div>
</div>

<h2 class="section-title">Top Scores</h2>
<div class="scores-wrapper">
  <table class="scores-table">
    <thead>
      <tr>
        <th>Map</th><th>Mods</th><th>PP</th><th>Acc</th><th>Combo</th><th>Miss</th><th>Date</th>
      </tr>
    </thead>
    <tbody>
      {% for score in top_scores %}
      <tr>
        <td><a href="{{ score.link }}">{{ score.bmap.full }}</a></td>
        <td>{{ score.mods_display }}</td>
        <td>{{ score.pp_display }}</td>
        <td>{{ score.acc|round(2) }}%</td>
        <td>{{ score.max_combo }}</td>
        <td>{{ score.hmiss }}</td>
        <td class="ts" data-ts="{{ score.date }}"></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<h2 class="section-title">Recent Scores</h2>
<div class="scores-wrapper">
  <table class="scores-table">
    <thead>
      <tr>
        <th>Map</th><th>Mods</th><th>PP</th><th>Acc</th><th>Combo</th><th>Miss</th><th>Date</th>
      </tr>
    </thead>
    <tbody>
      {% for score in recent_scores %}
      <tr>
        <td><a href="{{ score.link }}">{{ score.bmap.full }}</a></td>
        <td>{{ score.mods_display }}</td>
        <td>{{ score.pp_display }}</td>
        <td>{{ score.acc|round(2) }}%</td>
        <td>{{ score.max_combo }}</td>
        <td>{{ score.hmiss }}</td>
        <td class="ts" data-ts="{{ score.date }}"></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<script>
function formatUnixTimestamp(ts) {
  const raw = Number(ts);
  const date = raw > 9999999999 ? new Date(raw) : new Date(raw * 1000);
  if (Number.isNaN(date.getTime())) return "—";
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  const hours = String(date.getHours()).padStart(2, "0");
  const minutes = String(date.getMinutes()).padStart(2, "0");
  return `${year}-${month}-${day} ${hours}:${minutes}`;
}
document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll(".ts").forEach(el => {
    el.textContent = formatUnixTimestamp(el.dataset.ts);
  });
});
</script>
{% endblock %}
